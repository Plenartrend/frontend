# Development image: run next dev for hot reload
FROM node:22.11.0-alpine

RUN corepack enable

WORKDIR /app

COPY package.json yarn.lock* package-lock.json* .yarnrc.yml* ./
RUN \
  if [ -f yarn.lock ]; then yarn install; \
  elif [ -f package-lock.json ]; then npm ci; \
  else echo "Lockfile not found." && exit 1; \
  fi

EXPOSE 3000

ENV HOSTNAME="0.0.0.0"
ENV WATCHPACK_POLLING=true

# Install into mounted volume on start, then dev (so node_modules volume is populated)
CMD ["sh", "-c", "yarn install && yarn run dev"]
